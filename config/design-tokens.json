{
  "version": 1,
  "note": "Non-brand design tokens. Brand colors, fonts and the app name live in config/brand.json. Build with: node scripts/build-design-system.mjs",
  "type": {
    "base": 16,
    "readingWidth": "66ch",
    "scale": {
      "xs":   { "size": "0.75rem",  "line": "1rem" },
      "sm":   { "size": "0.875rem", "line": "1.375rem" },
      "base": { "size": "1rem",     "line": "1.625rem" },
      "lg":   { "size": "1.125rem", "line": "1.75rem" },
      "xl":   { "size": "1.3125rem","line": "1.875rem" },
      "2xl":  { "size": "1.5rem",   "line": "2rem" },
      "3xl":  { "size": "1.875rem", "line": "2.375rem" },
      "4xl":  { "size": "2.25rem",  "line": "2.75rem" }
    },
    "weights": { "regular": 400, "semibold": 600, "bold": 700 }
  },
  "spacing": "0.25rem",
  "radius": "0.75rem",
  "touchTarget": "44px",
  "shadow": {
    "light": { "card": "0 1px 2px rgb(16 24 40 / 0.06), 0 1px 3px rgb(16 24 40 / 0.10)", "raised": "0 4px 12px rgb(16 24 40 / 0.10)" },
    "dark":  { "card": "none", "raised": "0 4px 16px rgb(0 0 0 / 0.45)" }
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "fast": "150ms", "normal": "250ms", "slow": "450ms",
    "celebrate": "Passing a topic: the stop fills in and a check mark draws in 450ms. No confetti, no sound. With reduced motion: shown at once, no animation."
  },
  "levels": {
    "light": { "fresh": "#1f7a36", "junior": "#0b6f7c", "mid": "#0058b8", "senior": "#3634a3", "staff": "#7d3c9e" },
    "dark":  { "fresh": "#30d158", "junior": "#40c8e0", "mid": "#4da3ff", "senior": "#9a97ff", "staff": "#cf7cf5" }
  }
}
